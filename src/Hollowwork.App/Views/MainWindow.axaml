<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hollowwork.App.ViewModels"
        xmlns:cp="using:Avalonia.Controls"
        xmlns:controls="using:Hollowwork.App.Controls"
        x:Class="Hollowwork.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hollowwork"
        Icon="/Assets/icon.png"
        Width="1360" Height="820"
        MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource VoidGradient}">

    <Window.Resources>
        <DataTemplate x:Key="ParameterTemplate" x:DataType="vm:PatchParameterViewModel">

                                                            <StackPanel Margin="0,2,0,0" Spacing="2">
                                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                                            IsVisible="{Binding IsColor}">
                                                                    <Button Width="44" Height="26" Padding="0"
                                                                            Background="Transparent"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            VerticalContentAlignment="Stretch"
                                                                            BorderBrush="{DynamicResource LineBrush}"
                                                                            BorderThickness="1"
                                                                            ToolTip.Tip="Pick color">
                                                                        <Grid>
                                                                            <Border Background="#2A2A2A" />
                                                                            <Border Background="{Binding PreviewBrush}" />
                                                                        </Grid>
                                                                        <Button.Flyout>
                                                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                                                <cp:ColorView Color="{Binding Color, Mode=TwoWay}"
                                                                                              Width="320" Height="380"
                                                                                              IsAlphaEnabled="True"
                                                                                              IsAlphaVisible="True" />
                                                                            </Flyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                    <TextBox Text="{Binding ColorText, Mode=TwoWay}"
                                                                             Width="96" FontSize="11" />
                                                                </StackPanel>
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      IsVisible="{Binding !IsColor}">
                                                                    <Slider MaxWidth="360" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                                            TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                                                                            Value="{Binding Value, Mode=TwoWay}" />
                                                                    <TextBlock Grid.Column="1" Classes="mono faint"
                                                                               Text="{Binding Display}" Margin="8,0,0,0"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </StackPanel>
                                                        
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="46,*,26">

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource DeepBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="18,0,10,0">

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Path Data="M0,4 L4,0 L8,4 L4,8 Z"
                          Fill="{DynamicResource SoulBrush}" Width="9" Height="9" Stretch="Fill" />
                    <TextBlock Classes="brand" Text="HOLLOWWORK" VerticalAlignment="Center" />
                    <TextBlock Classes="eyebrow" Text="WORKBENCH" VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Width="1" Height="18" Margin="18,0"
                        Background="{DynamicResource LineBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Classes="mono faint" VerticalAlignment="Center"
                           Text="{Binding ArchiveLabel}" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="BACKUP" Click="OnBackupClicked" />
                    <Button Classes="ghost" Content="DOCS" />
                    <Button Classes="ghost" Content="SETTINGS" />
                    <Button Classes="primary" Content="OPEN">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="GGPK file…" Click="OnOpenGgpkClicked" />
                                <MenuItem Header="Bundles2 folder…" Click="OnOpenBundlesClicked" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="86,292,*,348">

            <!-- Mode rail -->
            <Border Grid.Column="0" Background="{DynamicResource VoidBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10,0,0" Spacing="2">
                    <Button Classes="rail" Classes.active="{Binding IsArchiveMode}" Click="OnArchiveModeClicked">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="eyebrow" Text="01" />
                            <TextBlock Classes="mono" Text="ARCHIVE" />
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsPatchesMode}" Click="OnPatchesModeClicked">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="eyebrow" Text="02" />
                            <TextBlock Classes="mono" Text="PATCHES" />
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Click="OnBackupClicked">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="eyebrow" Text="03" />
                            <TextBlock Classes="mono" Text="BACKUP" />
                        </StackPanel>
                    </Button>
                    <Button Classes="rail" Classes.active="{Binding IsSettingsMode}" Click="OnSettingsModeClicked">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="eyebrow" Text="04" />
                            <TextBlock Classes="mono" Text="SETTINGS" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Explorer -->
            <Border Grid.Column="1" Classes="panel" IsVisible="{Binding ShowExplorer}">
                <Grid RowDefinitions="Auto,Auto,180,Auto,Auto,*" Margin="14,14,14,10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="eyebrow" Text="EXPLORER" />
                        <TextBlock Grid.Column="1" Classes="mono faint" Text="{Binding CountLabel}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Classes="eyebrow" Text="DIRECTORIES" Margin="0,12,0,6" />

                    <ListBox Grid.Row="2" x:Name="DirectoryList"
                             ItemsSource="{Binding Directories}"
                             SelectionChanged="OnDirectorySelected"
                             Background="Transparent" BorderThickness="0" />

                    <Border Grid.Row="3" Classes="rule" Margin="0,10" />

                    <TextBlock Grid.Row="4" Classes="eyebrow" Text="FILES" Margin="0,0,0,6" />

                    <ListBox Grid.Row="5" x:Name="FileList"
                             ItemsSource="{Binding Files}"
                             SelectionChanged="OnFileSelected"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArchiveFileItem">
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Canvas / preview -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowPreview}">
                <Border Grid.Row="0" Background="{DynamicResource DeepBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1"
                        Height="34">
                    <StackPanel Orientation="Horizontal">
                        <Border Padding="16,0" BorderBrush="{DynamicResource SoulBrush}" BorderThickness="0,0,0,2">
                            <TextBlock Classes="mono" Text="PREVIEW" Foreground="{DynamicResource SoulBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Padding="18,6" Background="{DynamicResource DeepBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="mono faint" Text="{Binding PreviewHeader}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost" Content="EXPORT"
                                IsEnabled="{Binding CanExport}" Click="OnExportClicked" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                             IsVisible="{Binding !HasImage}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="{DynamicResource MonoFont}"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="18,12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                    <Image Source="{Binding PreviewImage}"
                           IsVisible="{Binding HasImage}"
                           Stretch="Uniform"
                           Margin="24" />
                </Grid>
            </Grid>

            <!-- Patch drawer -->
            <Border Grid.Column="{Binding PatchColumn}" Grid.ColumnSpan="{Binding PatchColumnSpan}"
                    IsVisible="{Binding ShowPatches}" Background="{DynamicResource DeepBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto" MaxWidth="980" HorizontalAlignment="Center">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,16,16,0">
                        <TextBlock Grid.Column="0" Classes="eyebrow" Text="PATCHES" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="92" FontSize="11"
                                  ItemsSource="{Binding Games}"
                                  SelectedItem="{Binding SelectedGame}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Classes="mono faint" Margin="16,8,16,8"
                               Text="{Binding SelectionLabel}" />

                    <ScrollViewer Grid.Row="2">
                        <ListBox ItemsSource="{Binding Patches}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PatchItemViewModel">
                                    <Border Classes="patchRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox Grid.Column="0" Margin="0,0,10,0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Classes="mono faint" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                                                <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,4,0,0"
                                                              ItemTemplate="{StaticResource ParameterTemplate}" />
                                                <Border IsVisible="{Binding IsMinimap}" Height="130" Margin="0,8,0,2"
                                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                    <controls:MinimapPreview MaxWidth="600" HorizontalAlignment="Left"
                                                        ExploredBrush="{Binding ExploredBrush}"
                                                        EdgeBrush="{Binding EdgeBrush}"
                                                        UnexploredBrush="{Binding UnexploredBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <Border Grid.Column="2" BorderBrush="{DynamicResource LineBrush}"
                                                    BorderThickness="1" CornerRadius="2" Padding="5,2">
                                                <TextBlock Classes="eyebrow" Text="{Binding Tag}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="mono faint" Text="{Binding PlanSummary}" />
                                <TextBlock Classes="mono faint" Text="{Binding BackupNotice}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="PLAN" Click="OnPlanClicked" />
                                <Button Classes="primary" Content="{Binding ApplyLabel}"
                                        IsEnabled="{Binding CanApply}" Click="OnApplyClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <!-- Chronicle -->
            <Border Grid.Column="1" Grid.ColumnSpan="3" IsVisible="{Binding ShowChronicle}"
                    Background="{DynamicResource VoidGradient}">
                <Grid ColumnDefinitions="420,*">
                    <Border Grid.Column="0" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,1,0"
                            Padding="30,22,22,22">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="chronicle" Text="PATCHES" />
                                    <Border Height="1" Width="160" Background="{DynamicResource SoulDimBrush}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Content="EXPLORER" FontSize="10"
                                        VerticalAlignment="Top" Click="OnExplorerClicked" />
                            </Grid>
                            <TextBlock Grid.Row="1" Classes="mono faint" Text="{Binding SelectionLabel}"
                                       Margin="0,12,0,10" />
                            <ListBox Grid.Row="2" ItemsSource="{Binding Patches}" SelectedItem="{Binding SelectedPatch}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PatchItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Height="34">
                                            <ToggleButton Classes="seal" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center">
                                                <Path Data="M7,0 L14,7 L7,14 L0,7 Z" Fill="{Binding SealFill}"
                                                      Stroke="{Binding SealStroke}" StrokeThickness="1"
                                                      Width="13" Height="13" Stretch="Fill" />
                                            </ToggleButton>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" FontSize="12" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Classes="mono faint" Text="{Binding CompactSummary}" />
                                                <Border Width="10" Height="10" Background="{Binding ExploredBrush}"
                                                        IsVisible="{Binding IsMinimap}" BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1" />
                                                <Border Width="10" Height="10" Background="{Binding EdgeBrush}"
                                                        IsVisible="{Binding IsMinimap}" BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1" />
                                                <Border Width="10" Height="10" Background="{Binding UnexploredBrush}"
                                                        IsVisible="{Binding IsMinimap}" BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
                                <Path Data="M0,0 L58,0 M0,0 L44,44 M0,0 L0,58 M16,0 C16,12 0,12 0,16 M32,0 C32,22 0,22 0,32"
                                      Stroke="{DynamicResource LineBrush}" StrokeThickness="1" Opacity="0.7" />
                                <Path Data="M420,560 C440,530 460,550 480,520"
                                      Stroke="{DynamicResource SoulDimBrush}" StrokeThickness="1" Opacity="0.5" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Padding="36,26">
                        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding HasSelectedPatch}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="display" Text="{Binding SelectedPatch.Name}" FontSize="26" />
                                <TextBlock Classes="dim" Text="{Binding SelectedPatch.Description}" TextWrapping="Wrap" />
                                <TextBlock Classes="eyebrow" Text="{Binding SelectedPatch.Meta}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="0,18">
                                <StackPanel Spacing="16">
                                    <ItemsControl ItemsSource="{Binding SelectedPatch.Parameters}"
                                                  ItemTemplate="{StaticResource ParameterTemplate}" />
                                    <Border IsVisible="{Binding SelectedPatch.IsMinimap}" Height="150" MaxWidth="520"
                                            HorizontalAlignment="Left" BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1">
                                        <controls:MinimapPreview ExploredBrush="{Binding SelectedPatch.ExploredBrush}"
                                                                 EdgeBrush="{Binding SelectedPatch.EdgeBrush}"
                                                                 UnexploredBrush="{Binding SelectedPatch.UnexploredBrush}" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="mono faint" Text="{Binding PlanSummary}" />
                                    <TextBlock Classes="mono faint" Text="{Binding BackupNotice}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="PLAN" Click="OnPlanClicked" />
                                    <Button Classes="primary" Content="{Binding ApplyLabel}"
                                            IsEnabled="{Binding CanApply}" Click="OnApplyClicked" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Settings -->
            <Border Grid.Column="1" Grid.ColumnSpan="3" IsVisible="{Binding ShowSettings}"
                    Background="{DynamicResource VoidGradient}">
                <ScrollViewer>
                    <StackPanel Margin="42,32" Spacing="22" MaxWidth="980" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="display" Text="Settings" />
                            <TextBlock Classes="dim" Text="Local paths and defaults. Nothing leaves this machine." />
                        </StackPanel>

                        <Border Classes="rule" />

                        <StackPanel Spacing="12">
                            <TextBlock Classes="eyebrow" Text="PATHS" />
                            <Grid ColumnDefinitions="150,*">
                                <TextBlock Classes="mono faint" Text="ARCHIVE" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding ArchivePathText}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnDefinitions="150,*">
                                <TextBlock Classes="mono faint" Text="OODLE" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding OodlePathText}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnDefinitions="150,*">
                                <TextBlock Classes="mono faint" Text="BACKUPS" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding BackupRootText}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnDefinitions="150,*">
                                <TextBlock Classes="mono faint" Text="SETTINGS" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SettingsPathText}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="OPEN DATA FOLDER" Click="OnOpenDataFolderClicked" />
                            <Button Content="OPEN BACKUPS" Click="OnBackupClicked" />
                        </StackPanel>

                        <Border Classes="rule" />

                        <StackPanel Spacing="6">
                            <TextBlock Classes="eyebrow" Text="OODLE" />
                            <TextBlock Classes="dim" TextWrapping="Wrap"
                                       Text="Hollowwork does not ship Oodle. Place liboo2corelinux64.so.9 in ~/.local/share/Hollowwork/oo2core/ or set HOLLOWWORK_OODLE." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource DeepBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="16,0">
                <TextBlock Grid.Column="0" Classes="mono" Foreground="{DynamicResource MossBrush}"
                           VerticalAlignment="Center" Text="OFFLINE" />
                <TextBlock Grid.Column="1" Classes="mono faint" Margin="18,0,0,0"
                           VerticalAlignment="Center" Text="{Binding StatusLabel}" />
                <TextBlock Grid.Column="2" Classes="mono faint" Margin="18,0,0,0"
                           VerticalAlignment="Center" Text="{Binding KindLabel}" />
                <TextBlock Grid.Column="3" Classes="mono faint" Margin="0,0,18,0"
                           VerticalAlignment="Center" Text="{Binding CountLabel}" />
                <TextBlock Grid.Column="4" Classes="mono faint"
                           VerticalAlignment="Center" Text="v0.1.0-dev · LINUX" />
            </Grid>
        </Border>
    </Grid>
</Window>
