<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hollowwork.App.ViewModels"
        x:Class="Hollowwork.App.Views.LiveWindow"
        x:DataType="vm:LiveViewModel"
        Title="Hollowwork Live"
        Icon="/Assets/icon.png"
        Width="520" Height="740"
        MinWidth="460" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource VoidGradient}">

    <Grid RowDefinitions="46,*,Auto">

        <Border Grid.Row="0" Background="{DynamicResource DeepBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" Margin="18,0,12,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Path Data="M0,4 L4,0 L8,4 L4,8 Z" Fill="{DynamicResource SoulBrush}"
                          Width="9" Height="9" Stretch="Fill" />
                    <TextBlock Classes="brand" Text="HOLLOWWORK" />
                    <TextBlock Classes="mono faint" Text="LIVE · POE 1" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="CLOSE" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="22,18,22,18" Spacing="14">

                <Border Padding="12,10" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="mono faint" Text="STATUS" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="12" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="mono" Text="HEALTH" />
                            <TextBlock Grid.Column="1" Classes="mono faint" Text="{Binding HpText}" />
                        </Grid>
                        <ProgressBar Value="{Binding HpPercent}" Maximum="100" Height="6" />
                    </StackPanel>
                </Border>

                <Border Padding="12" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="mono" Text="ENERGY SHIELD" />
                            <TextBlock Grid.Column="1" Classes="mono faint" Text="{Binding EsText}" />
                        </Grid>
                        <ProgressBar Value="{Binding EsPercent}" Maximum="100" Height="6" />
                    </StackPanel>
                </Border>

                <Border Padding="12" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="mono" Text="MANA" />
                            <TextBlock Grid.Column="1" Classes="mono faint" Text="{Binding MpText}" />
                        </Grid>
                        <ProgressBar Value="{Binding MpPercent}" Maximum="100" Height="6" />
                    </StackPanel>
                </Border>

                <Button Classes="primary" Content="{Binding StartLabel}" Height="38"
                        HorizontalAlignment="Stretch" Click="OnStartStopClicked" />

                <Border Classes="rule" />

                <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow" Text="FLASKS" />
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <CheckBox Grid.Row="0" Content="HP" IsChecked="{Binding HpEnabled}" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="99"
                                Value="{Binding HpThreshold}" Margin="8,0" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="mono faint"
                                   Text="{Binding HpThreshold, StringFormat={}{0:0}%}" VerticalAlignment="Center" />

                        <CheckBox Grid.Row="1" Content="ES" IsChecked="{Binding EsEnabled}" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="99"
                                Value="{Binding EsThreshold}" Margin="8,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="mono faint"
                                   Text="{Binding EsThreshold, StringFormat={}{0:0}%}" VerticalAlignment="Center" />

                        <CheckBox Grid.Row="2" Content="MP" IsChecked="{Binding MpEnabled}" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="99"
                                Value="{Binding MpThreshold}" Margin="8,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="mono faint"
                                   Text="{Binding MpThreshold, StringFormat={}{0:0}%}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8"
                      ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Classes="mono faint" Text="HP KEY" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HpKey}" MaxLength="16" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="mono faint" Text="ES KEY" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EsKey}" MaxLength="16" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Classes="mono faint" Text="MP KEY" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding MpKey}" MaxLength="16" />

                    <TextBlock Grid.Row="1" Classes="mono faint" Text="COOLDOWN (MS)" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CooldownText}" MaxLength="6" />
                    <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4"
                              Content="Only send keys while the game is focused"
                              IsChecked="{Binding RequireFocus}" />
                </Grid>

                <TextBlock Classes="mono faint" TextWrapping="Wrap"
                           Text="The app reads HP/ES/MP from the PoE1 process and sends the configured flask keys through X11. No AutoHotkey. Stop before changing characters or areas." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource DeepBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <TextBlock Classes="mono faint" Text="{Binding LastAction}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
