{
  "id": "poe1.camera-zoom",
  "name": "Camera zoom",
  "description": "Adds a camera zoom node to the player object (1.7x).",
  "game": "poe1",
  "targets": [
    {
      "root": "metadata/characters",
      "extensions": [".ot"],
      "files": ["metadata/characters/character.ot"]
    }
  ],
  "operations": [
    {
      "type": "replace",
      "from": "team = 1",
      "to": "team = 1\r\n\ton_initial_position_set = {CreateCameraZoomNode(5000.0, 5000.0, 1.7);} ",
      "unless": "CreateCameraZoomNode"
    }
  ]
}
