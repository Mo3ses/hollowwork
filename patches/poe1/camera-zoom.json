{
  "id": "poe1.camera-zoom",
  "name": "Camera zoom",
  "description": "Sets the zoom of the player camera node in the character object.",
  "game": "poe1",
  "parameters": [
    {
      "key": "zoom",
      "label": "Zoom",
      "min": 1.0,
      "max": 8.0,
      "step": 0.1,
      "default": 1.7
    }
  ],
  "targets": [
    {
      "root": "metadata/characters",
      "extensions": [
        ".ot"
      ],
      "files": [
        "metadata/characters/character.ot"
      ]
    }
  ],
  "operations": [
    {
      "type": "replaceRegex",
      "from": "CreateCameraZoomNode\\(\\s*5000\\.0\\s*,\\s*5000\\.0\\s*,\\s*[0-9.]+\\s*\\)",
      "to": "CreateCameraZoomNode(5000.0, 5000.0, {zoom})"
    },
    {
      "type": "replace",
      "from": "team = 1",
      "to": "team = 1\r\n\ton_initial_position_set = {CreateCameraZoomNode(5000.0, 5000.0, {zoom});} ",
      "unless": "CreateCameraZoomNode"
    }
  ]
}
